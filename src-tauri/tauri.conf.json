{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "movie-vault",
  "version": "0.2.1",
  "identifier": "com.movie-vault.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:movies.db"]
    },
    "updater": {
      "active": true,
      "endpoints": ["https://api.github.com/repos/SAMoosavi/movie-vault/releases/latest"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RkMwOUNGMEQ2ODhDQUEKUldTcWpHZ056d244S1N6a3hYTE1SRjd3NFhkb3RDMXUvMURONENqYjhXTjgzQUFQeW1lMVlSZzUK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "movie-vault",
        "width": 1000,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
